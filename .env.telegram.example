# Copy to .env.telegram. Do not commit real secrets.
# Railway: add these as service variables on the former web service (one replica).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_LANGUAGE=Hindi
# Comma-separated Telegram user IDs allowed to submit paid productions. Set to
# * to allow every direct-message user. Leave empty to deny all users.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_LANGUAGE=Hindi
TELEGRAM_PRODUCTION_MODE=live
# Existing backend settings remain in .env / Railway. Keep the existing encryption key:
# REPLICATE_API_TOKEN, OPENAI_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID
# and ALLOW_PAID_GENERATION. Optional YouTube publishing
# also needs ZERNIO_API_KEY and ZERNIO_YOUTUBE_ACCOUNT_ID. Keep
# YOUTUBE_PUBLISH_ENABLED=false until real posts are intended.
# Hosted workers also need DATABASE_URL and the existing S3_* variables.
# No Telegram phone number, password, api_id, api_hash, or webhook secret is needed.
