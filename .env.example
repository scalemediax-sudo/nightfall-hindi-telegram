# Backend settings. Telegram credentials belong in .env.telegram.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
# Default Hindi-capable horror narrator (Callum — Husky Trickster). Replace
# this only with a voice ID available to the configured ElevenLabs API key.
ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3dr4eOWO
ELEVENLABS_MODEL=eleven_multilingual_v2
# YouTube publishing stays disabled until a connected Zernio YouTube account is
# explicitly configured. Approval in Telegram never publishes while false.
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_ACCOUNT_ID=
YOUTUBE_PUBLISH_ENABLED=false
YOUTUBE_VISIBILITY=public
# Image and video generation is fixed to Replicate Pruna.
REPLICATE_API_TOKEN=
ALLOW_PAID_GENERATION=false
FFMPEG=ffmpeg
FFPROBE=ffprobe
BGM_FILE=
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
MAX_JOBS_PER_USER=3
